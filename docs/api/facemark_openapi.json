  "info": {
    "title": "FaceMark API",
    "description": "Student Attendance Management System with AI Facial Recognition",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "ziad_taha",
            "description": "The desired username"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "description": "Secure password (min 6 chars)"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "staff",
              "student"
            ],
            "default": "student",
            "description": "Role for the user"
          }
        },
        "required": [
          "username",
          "password",
          "role"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "ziad_taha",
            "description": "The username of the user"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "description": "The password of the user (min 6 chars)"
          },
          "role": {
            "type": "string",
            "example": "student",
            "enum": [
              "admin",
              "staff",
              "student"
            ],
            "description": "The role of the user logging in"
          }
        },
        "required": [
          "username",
          "password",
          "role"
        ]
      },
      "UserAccount": {
        "type": "object",
        "properties": {
          "userAccountId": {
            "type": "number",
            "example": 1,
            "description": "The unique identifier of the user"
          },
          "username": {
            "type": "string",
            "example": "ziad_taha",
            "description": "The unique username of the user"
          },
          "password": {
            "type": "string",
            "example": "hashed_password",
            "description": "The hashed password (hidden in responses usually)"
          },
          "userType": {
            "type": "string",
            "enum": [
              "admin",
              "staff",
              "student"
            ],
            "default": "student",
            "description": "The role of the user"
          },
          "isDeleted": {
            "type": "boolean",
            "example": false,
            "description": "Soft deletion flag"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2024-01-01T00:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2024-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "userAccountId",
          "username",
          "password",
          "userType",
          "isDeleted",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateCourseDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Mathematics",
            "description": "The name of the course"
          },
          "code": {
            "type": "string",
            "example": "MATH101",
            "description": "Unique course code"
          },
          "description": {
            "type": "string",
            "example": "Introductory calculus and algebra",
            "description": "Course description"
          },
          "sections": {
            "type": "number",
            "example": 4,
            "description": "Number of sections",
            "default": 1
          },
          "credits": {
            "type": "number",
            "example": 3,
            "description": "Credit hours for the course",
            "default": 3
          },
          "schedule": {
            "type": "string",
            "example": "Mon/Wed 10:00-12:00",
            "description": "Course schedule"
          },
          "room": {
            "type": "string",
            "example": "Room 302",
            "description": "Course room"
          },
          "instructorId": {
            "type": "number",
            "example": 2,
            "description": "User ID of the instructor (Staff)"
          },
          "adminId": {
            "type": "number",
            "example": 1,
            "description": "User ID of the admin manager"
          }
        },
        "required": [
          "name",
          "code",
          "sections",
          "credits",
          "instructorId"
        ]
      },
      "UpdateCourseDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Mathematics",
            "description": "The name of the course"
          },
          "code": {
            "type": "string",
            "example": "MATH101",
            "description": "Unique course code"
          },
          "description": {
            "type": "string",
            "example": "Introductory calculus and algebra",
            "description": "Course description"
          },
          "sections": {
            "type": "number",
            "example": 4,
            "description": "Number of sections",
            "default": 1
          },
          "credits": {
            "type": "number",
            "example": 3,
            "description": "Credit hours for the course",
            "default": 3
          },
          "schedule": {
            "type": "string",
            "example": "Mon/Wed 10:00-12:00",
            "description": "Course schedule"
          },
          "room": {
            "type": "string",
            "example": "Room 302",
            "description": "Course room"
          },
          "instructorId": {
            "type": "number",
            "example": 2,
            "description": "User ID of the instructor (Staff)"
          },
          "adminId": {
            "type": "number",
            "example": 1,
            "description": "User ID of the admin manager"
          }
        }
      },
      "UpdateAttendanceDto": {
        "type": "object",
        "properties": {
          "attendanceStatusId": {
            "type": "number",
            "example": 1,
            "description": "1=Present, 2=Absent, 3=Late, 4=Excused"
          },
          "recordDate": {
            "type": "string",
            "example": "2024-01-15"
          },
          "sectionNumber": {
            "type": "number",
            "example": 1
          },
          "sessionType": {
            "type": "string",
            "example": "LECTURE",
            "enum": [
              "LECTURE",
              "SECTION"
            ]
          },
          "room": {
            "type": "string",
            "example": "R3"
          },
          "faceConfidence": {
            "type": "number",
            "example": 0.95
          },
          "checkInTime": {
            "type": "string",
            "example": "09:30:00"
          }
        }
      },
      "BatchAlertDto": {
        "type": "object",
        "properties": {
          "userIds": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "example": [1, 2, 3],
            "description": "List of user account IDs"
          },
          "message": {
            "type": "string",
            "example": "Important update for all students",
            "description": "The alert message content"
          },
          "title": {
            "type": "string",
            "example": "System Notification",
            "description": "Alert title"
          },
          "type": {
            "type": "string",
            "example": "info",
            "enum": ["info", "warning", "error", "success"]
          }
        },
        "required": ["userIds", "message"]
      }
    }
  }
