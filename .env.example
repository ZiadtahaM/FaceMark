# ==============================================================================
# FACEMARK SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env'
# 2. FILL IN THE VALUES BELOW manually based on your local machine setup.
# ==============================================================================

# --- APPLICATION SETTINGS ---
# Environment: development, production, test
NODE_ENV=ENTER_YOUR_ENVIRONMENT_HERE

# The port the server will listen on (e.g., 3000)
PORT=ENTER_YOUR_PORT_HERE

# --- DATABASE SETTINGS (MySQL) ---
# Database host (usually localhost for local development)
DB_HOST=ENTER_YOUR_DB_HOST_HERE

# Database port (default MySQL port is 3306)
DB_PORT=ENTER_YOUR_DB_PORT_HERE

# Database username (e.g., root)
DB_USERNAME=ENTER_YOUR_DB_USERNAME_HERE

# Database password (the password for your local MySQL server)
DB_PASSWORD=ENTER_YOUR_DB_PASSWORD_HERE

# The name of the database to use (e.g., facemark)
DB_NAME=ENTER_YOUR_DB_NAME_HERE

# Synchronization: set to 'true' only for the FIRST run to create tables.
# Change to 'false' afterwards to preserve data.
DB_SYNCHRONIZE=ENTER_TRUE_OR_FALSE_HERE

# --- JWT AUTHENTICATION SETTINGS ---
# Secret key used for signing JWT tokens (use a random strong string)
JWT_SECRET=ENTER_YOUR_JWT_SECRET_HERE

# Token expiration time (e.g., 1h, 1d, 7d)
JWT_EXPIRES_IN=ENTER_YOUR_JWT_EXPIRES_IN_HERE

# --- AI VISION SERVICE ---
AI_SERVICE_URL=http://localhost:8000
